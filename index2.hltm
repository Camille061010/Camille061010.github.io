
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8" />
    <title>Accueil</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="style.css" rel="stylesheet" />
</head>
<body>

<nav>
    <a href="index.html">Accueil</a>
    <a href="basket.html">Basket</a>
    <a href="livres.html">Livres</a>

</nav>

<main class="container">
    <h1>Bienvenue sur mon site</h1>
    <p style="text-align:center;max-width:800px;margin:10px auto;">
        Découvre mes centres d’intérêt : le <strong>basket</strong> et les <strong>livres</strong>.
        Tu peux lancer une petite musique ci-dessous pendant ta visite.
    </p>

    <!-- Musique + boutons Play / Pause / Stop -->
    <audio id="music" src="musique.mp3" preload="auto"></audio>
    <div class="buttons">
        <button onclick="document.getElementById('music').play()">▶️ Play</button>
        <button onclick="document.getElementById('music').pause()">⏸️ Pause</button>

 <button onclick="const a=document.getElementById('music'); a.pause(); a.currentTime=0;">⏹️ Stop</button>
    </div>
    <!-- Remarque : la lecture automatique est bloquée par la plupart des navigateurs.
         Le bouton Play permet à l’utilisateur de démarrer la musique. -->

    <h2>Aperçu des thèmes</h2>
    <section class="gallery">
        <!-- Images d’illustration : basket + livres -->
        <img src="https://images.unsplash.com/photo-1517649763962-0c623066013b?q=80&w=1200&auto=format&fit=crop"
             alt="Ballon de basket sur le parquet" />
        <img src="https://images.unsplash.com/photo-1516979187457-637abb4f9353?q=80&w=1200&auto=format&fit=crop"
             alt="Pile de livres ouverts" />

<img src="https://images.unsplash.com/photo-1546519638-68e109498ffc?q=80&w=1200&auto=format&fit=crop"
             alt="Panier de basket vu d’en bas" />
        <img src="https://images.unsplash.com/photo-1512820790803-83ca734da794?q=80&w=1200&auto=format&fit=crop"
             alt="Une bibliothèque avec des livres" />
    </section>
</main>

</body>
</html>




